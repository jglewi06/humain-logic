---
// Guide lead photo (same faded-photo technique as /news): bleeds in from the right and fades left + down into the
// page background; on mobile it is a band above the title that fades out at the bottom. WebP 640/1024 + 1024 JPG.
// `base` is the path without -<w>.<ext>. Alt text is kept (the photo is informative, not decorative).
interface Props { base: string; alt: string }
const { base, alt } = Astro.props;
---
<figure class="guide-hero-photo">
  <picture>
    <source type="image/webp" srcset={`${base}-640.webp 640w, ${base}-1024.webp 1024w`} sizes="(min-width:768px) 54vw, 100vw" />
    <img src={`${base}-1024.jpg`} width="1024" height="576" loading="eager" fetchpriority="high" decoding="async" alt={alt} />
  </picture>
  <figcaption class="photo-credit">Image: HumAIn Logic</figcaption>
</figure>
