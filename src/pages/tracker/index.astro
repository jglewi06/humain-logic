---
import Base from '../../layouts/Base.astro';
import jobsData from '../../data/jobs.json';
import { OUTLOOK, SITE, fmtDate, HIRING, HIRING_ORDER, HIRING_INTRO } from '../../lib/site';
import JobTimeline from '../../components/JobTimeline.astro';
import { jobsDatasetLd, itemList } from '../../lib/ld.mjs';
const groups = (['shift', 'watch', 'steady'] as const).map(k => ({ k, ...OUTLOOK[k], jobs: jobsData.jobs.filter(j => j.outlook === k) }));
const hgroups = HIRING_ORDER.map(k => ({ k, ...HIRING[k], jobs: jobsData.jobs.filter(j => j.employment_pressure_by_2030 === k) })).filter(g => g.jobs.length);
const ld = [jobsDatasetLd(jobsData), itemList('Jobs in the tracker', jobsData.jobs.map(j => ({ url: `${SITE.url}/tracker/jobs/${j.slug}`, name: j.name })))];
---
<Base title="Job safety tracker" description="How is AI changing your job? Calm, sourced outlooks for 31 jobs." jsonld={ld} json="/api/jobs.json">
<section class="page-head"><div class="container">
  <span class="eyebrow">Job safety tracker</span><h1>How is AI changing your job?</h1>
  <p class="lede">Most jobs aren’t disappearing. They’re changing. Find your job to see our outlook, the reasons, and the research behind it.</p>
  <p class="confidence" style="margin-top:var(--space-3)">Last updated {fmtDate(jobsData.updated)} · <a href="/methodology">How we decide</a> · <a href="/api/jobs.json">Download data (JSON)</a></p>
  <form class="job-search" action="/tracker" method="get" id="jform" style="max-width:560px"><label class="sr-only" for="job">Your job title</label><input class="input" id="job" name="job" list="job-list" placeholder="Check your job, e.g. receptionist" autocomplete="off"><button class="btn btn-primary" type="submit">Check</button></form>
  <datalist id="job-list">{jobsData.jobs.map(j => <option value={j.name} />)}</datalist>
  <p id="jmsg" role="status"></p>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <figure class="tracker-photo">
    <picture>
      <source type="image/webp" srcset="/img/tracker/tracker-job-loss-640.webp 640w, /img/tracker/tracker-job-loss-1024.webp 1024w" sizes="(min-width:1056px) 960px, calc(100vw - 40px)" />
      <img src="/img/tracker/tracker-job-loss-1024.jpg" width="1024" height="576" loading="lazy" decoding="async" alt="A person sits on office steps holding a box of desk belongings, looking out over the city." />
    </picture>
    <figcaption class="photo-credit">Image: HumAIn Logic</figcaption>
  </figure>
  <div class="outlook-groups">
    {groups.map(g => (
      <section class="panel" aria-labelledby={`g-${g.k}`}>
        <h2 id={`g-${g.k}`} style="font-size:var(--fs-h4);margin-bottom:var(--space-3)"><span class={`pill ${g.cls}`}><span aria-hidden="true">{g.icon}</span> {g.label}</span> <span class="confidence">{g.jobs.length} jobs</span></h2>
        <ol>{g.jobs.map(j => <li><a class="role" href={`/tracker/jobs/${j.slug}`}>{j.name}<span class="confidence">{j.confidence} confidence</span></a></li>)}</ol>
      </section>))}
  </div>
  <JobTimeline jobs={jobsData.jobs} id="tl" showSources title="Timeline: when could AI do most of each job's tasks?" />

  <section class="hiring panel" aria-labelledby="hi-h">
    <span class="eyebrow">A separate estimate</span>
    <h2 id="hi-h" style="font-size:var(--fs-h3);margin:var(--space-2) 0">Hiring impact by 2030</h2>
    <p class="confidence"><strong>HumAIn Logic estimate.</strong>{' '}{HIRING_INTRO} Open a job to read the reasons and sources.</p>
    <div class="hi-groups">{hgroups.map(g => <div>
      <h3 style="font-size:var(--fs-body)"><span class={`hi-tag ${g.cls}`}><span aria-hidden="true">{g.icon}</span> {g.label}</span> <span class="confidence">{g.jobs.length} jobs</span></h3>
      <ol>{g.jobs.map(j => <li><a href={`/tracker/jobs/${j.slug}#hiring-h`}>{j.name}</a></li>)}</ol></div>)}</div>
    {jobsData.employment_pressure_note && <details class="hi-src"><summary>About this estimate</summary><p class="confidence">Researcher's note: {jobsData.employment_pressure_note}</p></details>}
  </section>

  <section style="margin-top:var(--space-7)" aria-labelledby="gr-h"><h2 id="gr-h" style="font-size:var(--fs-h3);margin-bottom:var(--space-3)">Helpful for any job</h2>
    <ul class="panel" style="padding-left:40px">{jobsData.general_resources.map(r => <li><a href={r.url} rel="noopener">{r.label}</a></li>)}</ul>
    <p class="confidence" style="margin-top:var(--space-2)">{jobsData.help_note} Each job page lists practical next steps.</p></section>
  <p class="callout warm" style="margin-top:var(--space-6)"><strong>Please read:</strong> these are HumAIn Logic editorial estimates, not predictions or career advice. None of the cited sources gives per-job dates. Your own job depends on your tasks, employer and skills.</p>
</div>
</Base>
<script>
const jobs = [...document.querySelectorAll<HTMLOptionElement>('#job-list option')].map(o => o.value);
const links = Object.fromEntries([...document.querySelectorAll<HTMLAnchorElement>('.outlook-groups a.role')].map(a => [a.firstChild!.textContent!.trim().toLowerCase(), a.href]));
const go = (v: string) => {
  const s = v.trim().toLowerCase(); if (!s) return false;
  const hit = jobs.find(j => j.toLowerCase() === s) || jobs.find(j => j.toLowerCase().includes(s) || s.includes(j.toLowerCase().split(/[ /(]/)[0]));
  if (hit) { location.href = links[hit.toLowerCase()]; return true; }
  const m = document.getElementById('jmsg')!; m.textContent = `We don't have “${v}” yet. Try a similar job from the lists below, or ask us to add it on the Contact page.`; return false;
};
const q = new URLSearchParams(location.search).get('job'); if (q) { (document.getElementById('job') as HTMLInputElement).value = q; go(q); }
document.getElementById('jform')!.addEventListener('submit', e => { e.preventDefault(); go((document.getElementById('job') as HTMLInputElement).value); });
</script>
<style>
/* Tracker photo: soft radial fade into the page background (same mask technique as /news and the guides).
   The mask is on the <img>, so the credit pill stays crisp; it sits inside the opaque centre of the ellipse. */
.tracker-photo{position:relative;margin:0 auto var(--space-6);max-width:960px;aspect-ratio:16/9;pointer-events:none}
.tracker-photo picture{display:contents}
.tracker-photo img{display:block;width:100%;height:100%;object-fit:cover;opacity:.9;filter:saturate(.92) contrast(.97);
  -webkit-mask-image:radial-gradient(ellipse closest-side at center,#000 55%,transparent 100%);mask-image:radial-gradient(ellipse closest-side at center,#000 55%,transparent 100%)}
.tracker-photo .photo-credit{position:absolute;right:31%;bottom:31%;font:500 var(--fs-caption)/1 var(--font-body);color:var(--color-ink);background:rgba(255,255,255,.92);padding:6px 10px;border-radius:var(--radius-pill)}
@media (max-width:767px){.tracker-photo{margin-bottom:var(--space-5)}.tracker-photo .photo-credit{display:none} /* at phone size the unfaded centre is too small: the pill would cover the subject */}
</style>
