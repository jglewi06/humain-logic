---
import Base from '../layouts/Base.astro';
import { BOOKS } from '../data/bookstore';
---
<Base title="Bookstore: quick-read AI guides (PDF)" description="Simple, quick-read PDF guides from HumAIn Logic: enhanced editions of our free guides, with checklists, worksheets and ready-made prompts.">
<section class="page-head bookstore-head"><picture class="maya-bg" aria-hidden="true"><source type="image/webp" srcset="/img/bookstore/maya-reading-640.webp 640w, /img/bookstore/maya-reading-1024.webp 1024w" sizes="520px" /><img src="/img/bookstore/maya-reading-1024.webp" alt="" width="1024" height="576" loading="lazy" decoding="async" /></picture><div class="container"><span class="eyebrow">Bookstore</span><h1>Quick-read AI guides</h1><p class="lede">Enhanced PDF editions of our <a href="/guides">free guides</a>. Still simple and quick to read, with extra checklists, worksheets and ready-made prompts you can keep.</p></div></section>
<div class="section" style="padding-top:var(--space-6)"><div class="container">
  <ul class="grid-3 bookstore-grid" style="list-style:none;padding:0;margin:0">
    {BOOKS.map((b, i) => (<>
      {i === 3 && <li class="book-banner"><picture><source type="image/webp" srcset="/img/bookstore/maya-laptop-banner-640.webp 640w, /img/bookstore/maya-laptop-banner-1280.webp 1280w" sizes="(min-width: 1100px) 1100px, 100vw" /><img src="/img/bookstore/maya-laptop-banner-1280.webp" alt="Maya reading on a laptop" width="1280" height="533" loading="lazy" decoding="async" /></picture></li>}
      <li style="display:flex"><article class="tool" style="width:100%">
        <picture class="book-cover">
          <source type="image/webp" srcset={`/img/bookstore/${b.cover}-640.webp 640w, /img/bookstore/${b.cover}-1024.webp 1024w`} sizes="(min-width: 900px) 33vw, 100vw" />
          <img src={`/img/bookstore/${b.cover}.jpg`} alt={`${b.title} cover`} width="1024" height="1365" loading="lazy" decoding="async" />
        </picture>
        {b.badge && <span class="badge">{b.badge}</span>}
        <span class="eyebrow">PDF guide</span>
        <h2 class="h4" style="font-size:var(--fs-h4)">{b.title}</h2>
        <p class="what">{b.description}</p>
        <div class="facts"><span><strong>{b.pages} pages</strong></span><span>{b.readTime}</span></div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:var(--space-3)">
          <strong style="font:600 var(--fs-h4) var(--font-heading)">{b.price}</strong>
          {b.basedOn && <a class="meta" href={b.basedOn}>Read the free version</a>}
        </div>
        <div class="cta">
          {b.checkoutUrl
            ? <a class="btn btn-primary" href={b.checkoutUrl} rel="noopener">Buy for {b.price}</a>
            : <button class="btn btn-primary" type="button" disabled aria-disabled="true">Coming soon</button>}
        </div>
      </article></li>
    </>))}
  </ul>
  <p class="note">All sales are final. Because these are instant digital downloads, we don't offer refunds. Purchases include the version available at the time of sale.</p>
</div></div>
<style>
  .book-banner { grid-column: 1 / -1; display:flex; justify-content:center; }
  .book-banner picture { display:block; width:100%; }
  .book-banner img { width:100%; height:300px; object-fit:cover; object-position:70% 30%; display:block; opacity:.9;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent), linear-gradient(to bottom, transparent, #000 20%, #000 80%, transparent); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent), linear-gradient(to bottom, transparent, #000 20%, #000 80%, transparent); mask-composite: intersect; }
  @media (max-width: 899px) { .book-banner img { height:180px; } }
  .bookstore-head { position:relative; overflow:hidden; }
  .bookstore-head .container { position:relative; z-index:1; }
  .maya-bg { position:absolute; top:0; right:0; width:min(480px, 38vw); pointer-events:none; z-index:0; opacity:.65;
    -webkit-mask-image: linear-gradient(to left, #000 40%, transparent 95%), linear-gradient(to top, transparent 0%, #000 35%); -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to left, #000 40%, transparent 95%), linear-gradient(to top, transparent 0%, #000 35%); mask-composite: intersect; }
  .maya-bg img { width:100%; height:auto; display:block; }
  @media (min-width: 900px) { .bookstore-head .lede, .bookstore-head h1 { max-width: 58%; } }
  @media (max-width: 899px) { .maya-bg { display:none; } }
  .book-cover { display:block; aspect-ratio:3/4; overflow:hidden; border-radius:var(--radius-md); margin-bottom:var(--space-4); background:var(--color-surface-2, #eef2f1); }
  .book-cover img { width:100%; height:100%; object-fit:cover; display:block; }
</style>
</Base>
