---
import Base from '../layouts/Base.astro';
import categories from '../data/categories.json';
const popular = ['Write an email', 'Make a flyer', 'Take meeting notes', 'Summarize a document', 'Remove background from photo', 'Automate bookkeeping'];
---
<Base title="Search results" noindex description="Plain-language AI tool search.">
<section class="page-head"><div class="container">
  <span class="eyebrow">Find a tool</span>
  <h1 id="s-h">What do you want to get done?</h1>
  <form class="search compact" role="search" action="/search" method="get" id="sform">
    <div class="row" style="display:flex;gap:14px;align-items:center;flex:1;min-width:0">
      <svg width="24" height="24" aria-hidden="true"><use href="#i-search"/></svg>
      <div class="field"><label for="q">Describe your task</label><input id="q" name="q" type="search" enterkeyhint="search" autocomplete="off" placeholder="e.g. reply to an upset customer"></div>
    </div>
    <button class="btn btn-primary" type="submit">Find tools</button>
  </form>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div class="search-layout">
    <aside class="filters" aria-label="Filters">
      <fieldset><legend>Price</legend>
        <label><input type="checkbox" name="price" value="free-option"> Has a free plan</label>
        <label><input type="checkbox" name="price" value="free"> Completely free</label>
      </fieldset>
      <fieldset><legend>Category</legend>
        {categories.map(c => <label><input type="checkbox" name="cat" value={c.slug}> {c.label}</label>)}
      </fieldset>
      <button type="button" class="btn btn-ghost btn-sm" id="clear">Clear all filters</button>
      <p class="confidence" style="margin-top:var(--space-4)">“Has a free plan” only counts tools where we confirmed one. Tools with an unclear free plan are hidden while it's on.</p>
    </aside>
    <div>
      <div id="interp" aria-live="polite"></div>
      <h2 class="sr-only">Matched tools</h2>
      <p class="count" id="count" role="status" style="color:var(--color-slate);margin-bottom:var(--space-4)"></p>
      <div class="grid-2" id="results"></div>
      <div id="empty" hidden>
        <div class="panel">
          <h2 style="font-size:var(--fs-h3);margin-bottom:var(--space-3)" id="empty-h">We couldn't find a match yet.</h2>
          <p id="empty-fix"></p>
          <p style="margin:var(--space-3) 0">Try describing it another way, like “reply to reviews”. Or start from a popular task:</p>
          <div class="chips" style="justify-content:flex-start">{popular.map(p => <a class="chip" href={`/search?q=${encodeURIComponent(p)}`}>{p}</a>)}</div>
          <p style="margin-top:var(--space-4)"><a href="/tools">Browse all categories</a> · <a href="/contact#suggest">Tell us what you need</a></p>
        </div>
      </div>
      <div id="related" style="margin-top:var(--space-6)"></div>
      <noscript><p class="placeholder">Search needs JavaScript. You can <a href="/tools">browse all tools</a> or <a href="/tasks">browse by task</a> instead.</p></noscript>
    </div>
  </div>
</div>
</Base>
<script>
import { prepare, search } from '../lib/search-core.mjs';
type Task = { s: string; n: string; c: string[]; k: string[] };
type Tool = { s: string; n: string; d: string; c: string; cl: string; p: string; pl: string; f: boolean | null; sp: string | null; v: boolean; t: string[]; w: string };
const $ = (id: string) => document.getElementById(id)!;
const esc = (s: string) => s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
const params = new URLSearchParams(location.search);
const q = (params.get('q') || '').trim();
(document.getElementById('q') as HTMLInputElement).value = q;
let index: { tasks: Task[]; tools: Tool[] };
let prepared: any;

function render() {
  const sel = (n: string) => [...document.querySelectorAll<HTMLInputElement>(`input[name=${n}]:checked`)].map(i => i.value);
  const prices = sel('price'), cats = sel('cat');
  const chosenTask = params.get('task');
  const freeInQuery = /\bfree\b/i.test(q);
  if (freeInQuery && !params.has('price')) { (document.querySelector('input[value=free-option]') as HTMLInputElement).checked = true; params.set('price', 'free-option'); return render(); }
  const r = search(prepared ??= prepare(index), q, { chosenTask });
  const task: Task | undefined = r.task; const taskHits = r.taskHits; const ambiguous = r.ambiguous;
  // interpretation banner / ambiguity (ux/spec §1.1)
  let html = '';
  if (!q) html = '<p>Describe a task above, for example <em>write a job advert</em>.</p>';
  else if (q.length < 3 || /^ai$/i.test(q)) html = '<p class="interp">Try describing the task, e.g. <em>&nbsp;write a job advert</em>.</p>';
  else if (task && ambiguous) {
    html = `<div class="ambig"><fieldset><legend>“${esc(q)}” can mean a few things. Which is closest?</legend>${taskHits.slice(0, 4).map((h: any, i: number) => `<label><input type="radio" name="pick" value="${h.item.s}" ${i === 0 ? 'checked' : ''}> ${esc(h.item.n)}</label>`).join('')}</fieldset></div>`;
  } else if (task) html = `<div class="interp"><span>We think you want to: <strong>${esc(task.n)}</strong></span><button class="btn btn-ghost btn-sm" type="button" id="change">✎ Change</button></div>`;
  else if (r.closest) html = `<div class="interp"><span>No exact match for “${esc(q)}”. Showing the <strong>closest matches</strong>: ${esc(r.closestLabel)}.</span></div>`;
  $('interp').innerHTML = html;
  const all = r.results as { tool: Tool; score: number; why: string }[];
  // free_tier: true = has a free plan; false = no; null = unknown (never counted as free)
  const pass = (r: { tool: Tool }) => (!prices.length || prices.some(p => p === 'free' ? r.tool.p === 'free' : r.tool.f === true)) && (!cats.length || cats.includes(r.tool.c));
  const shown = all.filter(pass);
  const unknownHidden = prices.length ? all.filter(r => r.tool.f === null && (!cats.length || cats.includes(r.tool.c))).length : 0;
  $('count').textContent = q ? `${shown.length} tool${shown.length === 1 ? '' : 's'} match${unknownHidden ? ` · ${unknownHidden} hidden because we couldn't confirm a free plan` : ''}` : '';
  $('results').innerHTML = shown.map((r, i) => `<article class="tool compact">${i === 0 && !r.closest ? '<span class="badge">Best match</span>' : ''}<div class="top"><div><h3><a href="/tools/${r.tool.s}" style="color:inherit">${esc(r.tool.n)}</a></h3><div class="by">${esc(r.tool.cl)}</div></div></div><p class="what">${esc(r.tool.d)}</p><div class="badges"><span class="b b-price">${esc(r.tool.pl)}</span>${r.tool.sp ? `<span class="b b-price">Paid from ${esc(r.tool.sp)}</span>` : ''}${r.tool.v ? '' : '<span class="b b-unverified">Pricing unconfirmed</span>'}</div><p class="why-match">Why it matches: ${esc(r.why)}</p><div class="cta"><a class="btn btn-primary btn-sm" href="/tools/${r.tool.s}">View details</a></div></article>`).join('');
  $('empty').hidden = !q || shown.length > 0;
  if (q && !shown.length) {
    $('empty-h').textContent = `We couldn't find a tool for “${q}” yet.`;
    const lost = all.length - shown.length;
    $('empty-fix').innerHTML = lost ? `No results with these filters. <button type="button" class="btn btn-secondary btn-sm" id="clear2">Clear all filters (${all.length})</button>` : '';
    document.getElementById('clear2')?.addEventListener('click', clearAll);
  }
  const rel = task ? index.tasks.filter(t => t.s !== task!.s && t.c.some(c => task!.c.includes(c))).slice(0, 6) : [];
  $('related').innerHTML = rel.length ? `<h2 style="font-size:var(--fs-h4);margin-bottom:var(--space-3)">Related tasks</h2><div class="chips" style="justify-content:flex-start">${rel.map(t => `<a class="chip" href="/search?q=${encodeURIComponent(t.n)}&task=${t.s}">${esc(t.n)}</a>`).join('')}</div>` : '';
  document.getElementById('change')?.addEventListener('click', () => { const i = document.getElementById('q') as HTMLInputElement; i.focus(); i.select(); });
  document.querySelectorAll<HTMLInputElement>('input[name=pick]').forEach(r => r.addEventListener('change', () => { params.set('task', r.value); history.replaceState(null, '', '?' + params); render(); }));
}
function syncUrl() {
  for (const n of ['price', 'cat']) { params.delete(n); document.querySelectorAll<HTMLInputElement>(`input[name=${n}]:checked`).forEach(i => params.append(n, i.value)); }
  history.replaceState(null, '', '?' + params); render();
}
function clearAll() { document.querySelectorAll<HTMLInputElement>('.filters input').forEach(i => i.checked = false); syncUrl(); }
for (const n of ['price', 'cat']) params.getAll(n).forEach(v => { const el = document.querySelector<HTMLInputElement>(`input[name=${n}][value="${v}"]`); if (el) el.checked = true; });
document.querySelectorAll('.filters input').forEach(i => i.addEventListener('change', syncUrl));
$('clear').addEventListener('click', clearAll);
fetch('/api/search-index.json').then(r => r.json()).then(d => { index = d; render(); })
  .catch(() => { $('interp').innerHTML = '<div class="panel">Search is having trouble right now. <a class="btn btn-secondary btn-sm" href="">Try again</a> or <a href="/tools">browse categories</a>.</div>'; });
</script>
