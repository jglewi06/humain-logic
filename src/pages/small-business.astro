---
import Base from '../layouts/Base.astro';
const desc = "AI help for small businesses, from websites to custom automated software. Free consultations available: tell us what's slowing you down and get plain-language ideas.";
---
<Base path="/small-business" title="Small Business AI Solutions, Free Consultation" description={desc} image="/img/small-business/smb-hero-1200.jpg" imageAlt="A florist working in her small shop">
<div class="smb">
  <section class="smb-hero" aria-labelledby="smb-h">
    <div class="smb-hero-art" aria-hidden="true"></div>
    <div class="container smb-hero-inner">
      <span class="smb-chip">Free consultation</span>
      <h1 id="smb-h">AI help for your small business, at your pace</h1>
      <p class="smb-sub">Tell us what's slowing you down. We'll reply with plain-language ideas, no jargon and no pressure.</p>
      <p class="smb-sub2">We help with everything from simple websites to custom automated software that handles the busywork for you.</p>
      <button class="smb-btn-primary" type="button" id="smb-open" aria-expanded="false" aria-controls="consult">Free Consultation</button>
    </div>
  </section>

  <section class="container smb-video-wrap" aria-label="Video">
    <div class="smb-video-box">
      <video id="smb-video" class="smb-video" controls preload="auto" playsinline poster="/video/maya-poster.jpg" aria-label="Maya explains how AI can help your small business">
        <source src="/video/maya-ai-small-business.mp4" type="video/mp4">
      </video>
      <button type="button" id="smb-sound" class="smb-sound" hidden><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/></svg>Tap for sound</button>
    </div>
  </section>

  <section class="container smb-cards" aria-label="What to expect">
    <div class="smb-card"><h2>It's free</h2><p>No cost and no commitment to ask.</p></div>
    <div class="smb-card"><h2>No sales pitch</h2><p>Honest ideas, even if the answer is "you don't need AI."</p></div>
    <div class="smb-card"><h2>Real answers in plain words</h2><p>We skip the jargon and explain what would actually help.</p></div>
  </section>

  <section class="container smb-steps" aria-labelledby="how-h">
    <h2 id="how-h">How it works</h2>
    <ol>
      <li><span class="n" aria-hidden="true">1</span><div><h3>Tell us the problem</h3><p>Describe the task you'd like to automate or the software you wish you had.</p></div></li>
      <li><span class="n" aria-hidden="true">2</span><div><h3>We review it</h3><p>We look at what you shared and think through practical options.</p></div></li>
      <li><span class="n" aria-hidden="true">3</span><div><h3>We reply by email</h3><p>We reply by email within 2 business days.</p></div></li>
    </ol>
  </section>

  <section class="container smb-form-wrap" id="consult" hidden aria-labelledby="form-h">
    <div class="smb-grid">
      <div class="smb-form-card">
        <h2 id="form-h" tabindex="-1">Request your free consultation</h2>
        <div id="smb-summary" class="smb-summary" role="alert" aria-live="assertive" hidden></div>
        <form id="smb-form" novalidate>
          <div class="f">
            <label for="smb-message">What can we help with?</label>
            <p class="help" id="smb-message-help">A few sentences is plenty. What's the problem, and what do you hope to automate or want the software to do?</p>
            <textarea id="smb-message" name="message" rows="7" required aria-describedby="smb-message-help smb-message-err"></textarea>
            <p class="err" id="smb-message-err" hidden></p>
          </div>
          <div class="f">
            <label for="smb-email">Email</label>
            <input id="smb-email" name="email" type="email" autocomplete="email" required aria-describedby="smb-email-err">
            <p class="err" id="smb-email-err" hidden></p>
          </div>
          <div class="f">
            <label for="smb-phone">Phone <span class="opt">(optional)</span></label>
            <input id="smb-phone" name="phone" type="tel" autocomplete="tel">
          </div>
          <div class="hp" aria-hidden="true"><label for="smb-honey">Leave this unchecked</label><input id="smb-honey" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off"></div>
          <button class="smb-submit" type="submit">Request my free consultation</button>
          <p class="fine">We'll only use your details to reply. No spam, ever. <a href="/privacy">Privacy policy</a></p>
        </form>
        <div id="smb-success" class="smb-success" tabindex="-1" aria-live="polite" hidden>
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m7.5 12.5 3 3 6-6.5"/></svg>
          <p><strong>Thanks! We got your message.</strong> We'll review your request and reply within 2 business days.</p>
        </div>
      </div>
      <aside class="smb-aside" aria-label="About this consultation">
        <h3>What happens with your message</h3>
        <ul>
          <li>A real person reads it.</li>
          <li>We only use your email (and phone, if given) to reply.</li>
          <li>There's no cost and no obligation.</li>
          <li>Not sure how to describe it? Just tell us what eats up your time.</li>
        </ul>
      </aside>
    </div>
  </section>
  <section class="container smb-setup" id="setup-session" aria-labelledby="setup-h">
    <div class="smb-setup-card">
      <span class="smb-chip">Fixed price</span>
      <h2 id="setup-h">AI Setup Session — $149, 60 minutes</h2>
      <p class="smb-setup-lead"><strong>60 minutes. $149, fixed price. You leave with a written action plan.</strong></p>
      <p>You've heard AI can save your business time, but where do you start? In one focused session, Jordan Lewis M.S., founder of HumAIn Logic, works through your business with you, picks the AI tools that fit and shows you how to use them on your real tasks.</p>
      <div class="smb-setup-cols">
        <div>
          <h3>What's included</h3>
          <ul>
            <li><strong>A 60-minute one-to-one video session</strong> focused on your business, not a generic demo.</li>
            <li><strong>A quick look at how you work now:</strong> the tasks that take too long, the tools you already use and your budget.</li>
            <li><strong>Tool recommendations that fit you:</strong> which AI assistant and tools make sense for your business, and which ones you can skip.</li>
            <li><strong>Hands-on setup help:</strong> we set up or tune at least one tool together during the session, so you leave with something working.</li>
            <li><strong>Prompts made for your business:</strong> ready-to-use prompts for your top tasks, such as social posts, customer replies, quotes and planning.</li>
            <li><strong>Safety and privacy basics:</strong> what you should never paste into an AI tool, and how to check AI output before it reaches a customer.</li>
          </ul>
        </div>
        <div>
          <h3>What you get afterward</h3>
          <p>A written action plan, sent after your session. It includes:</p>
          <ul>
            <li>Your recommended tools, what each one is for and the plans to consider</li>
            <li>Your custom prompts, ready to copy and paste</li>
            <li>Step-by-step next actions for the next 30 days</li>
            <li>Notes on privacy and checking AI output</li>
          </ul>
          <h3>Who it's for</h3>
          <ul>
            <li>Small-business owners, sole traders and freelancers who are new to AI or have tried it and gotten stuck</li>
            <li>Small teams that want a simple, safe starting point</li>
            <li>Anyone who would rather spend an hour getting it right than weeks of trial and error</li>
          </ul>
          <p>No technical skills needed. If you can send an email, you're ready.</p>
        </div>
      </div>
      <h3>How to book</h3>
      <ol class="smb-setup-steps">
        <li><strong>Fill in the consultation form</strong> on this page. Tell us about your business and what you'd like help with.</li>
        <li><strong>We reply within 2 business days</strong> with available times and a payment link.</li>
        <li><strong>Pick your time and pay.</strong> Your session is confirmed once payment is received.</li>
        <li><strong>Meet online.</strong> We'll send a video call link before your session. Have your laptop or phone handy and the logins for any tools you already use.</li>
        <li><strong>Get your action plan.</strong> Your written plan arrives after the session.</li>
      </ol>
      <p class="smb-price"><span class="amt">$149</span> <span class="per">fixed price. No hourly billing and no surprise extras. Covers the 60-minute session and your written action plan.</span></p>
      <button type="button" class="smb-btn-primary" data-consult>Book your AI Setup Session</button>
      <details class="smb-details smb-setup-faq">
        <summary>Questions about the session</summary>
        <p><strong>Do I need to prepare anything?</strong> Just fill in the form as fully as you can. A short list of your most time-consuming tasks helps a lot.</p>
        <p><strong>Is this right if I've never used AI?</strong> Yes. Many clients start from zero.</p>
        <p><strong>Will you recommend tools that pay you?</strong> We recommend what fits your business. HumAIn Logic never sells rankings, and any paid placement on our site is clearly labeled "Featured".</p>
        <p><strong>Is this legal, tax or financial advice?</strong> No. We'll help you use AI tools well. For legal, tax or financial questions, talk to a qualified professional.</p>
      </details>
      <p class="smb-setup-q">Questions? Email <a href="mailto:hello@humainlogic.com">hello@humainlogic.com</a>.</p>
    </div>
  </section>
  <section class="container smb-pricing" id="pricing" aria-labelledby="price-h">
    <h2 id="price-h">Pricing for our other services</h2>
    <p class="smb-price-note">Every project starts with a free consultation. The prices below are for the work that follows, if you decide to go ahead.</p>
    <div class="smb-price-grid">
      <article class="smb-price-card">
        <h3>Custom Website</h3>
        <p class="smb-price"><span class="amt">$500</span> <span class="per">one-time</span></p>
        <ul>
          <li>Custom website development</li>
          <li>Agentic optimization, so AI search tools can find and understand your site</li>
          <li>Your own unique domain name</li>
        </ul>
        <button type="button" class="smb-price-cta" data-consult>Start with a free consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Standard Maintenance</h3>
        <p class="smb-price"><span class="amt">$250</span> <span class="per">per month</span></p>
        <ul>
          <li>Troubleshooting and website repair</li>
          <li>We launch your website and maintain it for you</li>
          <li>No getting bogged down with maintenance and coding issues</li>
        </ul>
        <button type="button" class="smb-price-cta" data-consult>Start with a free consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Custom Solutions</h3>
        <p class="smb-price"><span class="amt">$999.99</span> <span class="per">plus $220/month maintenance</span></p>
        <ul>
          <li>A custom solution built around your business</li>
          <li>Ongoing maintenance subscription included at $220 per month</li>
          <li>No hassle</li>
        </ul>
        <button type="button" class="smb-price-cta" data-consult>Start with a free consultation</button>
      </article>
    </div>
  </section>
  <section class="container smb-pricing smb-quickfixes" id="quick-fixes" aria-labelledby="qf-h">
    <h2 id="qf-h">Common quick fixes</h2>
    <div class="smb-price-grid">
      <article class="smb-price-card">
        <h3>Review responder</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">Pulls in Google reviews, drafts polite AI replies for the owner to approve, and texts happy customers asking for a review.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Quote and invoice builder</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">Describe a job by voice or text and get a branded quote, then turn it into an invoice with a payment link.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Social post autopilot</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">A month of posts written from the business's own photos and specials, scheduled to Facebook and Instagram.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Policy and handbook generator</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">An employee handbook, privacy policy and SOPs built from a short questionnaire, with a 'not legal advice' note.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Inventory and reorder tracker</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">A simple sheet-style app that flags low stock and drafts supplier orders.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
      <article class="smb-price-card">
        <h3>Customer FAQ chatbot</h3>
        <p class="smb-price"><span class="per">Starting at</span> <span class="amt">$999.00</span></p>
        <p class="smb-qf-desc">Trained on the business's own website and menu, added to their site with one line of code.</p>
        <button type="button" class="smb-price-cta" data-consult>Schedule consultation</button>
      </article>
    </div>
  </section>

  <section class="container smb-compare" aria-labelledby="cmp-h">
    <h2 id="cmp-h">How our prices compare</h2>
    <p class="smb-cmp-lead">We checked every figure below on Oct 31, 2026. Each one is labelled <strong>Official (government)</strong>, <strong>Independent survey</strong>, or <strong>Vendor-published price or estimate</strong>. Vendor figures come from companies that sell the service, so they are not market averages.</p>
    <p class="smb-callout"><strong>No official or independent national average exists for monthly website maintenance or for custom AI/automation projects.</strong> Only vendor estimates exist for those.</p>
    <details class="smb-details" open>
      <summary>Official and independent figures</summary>
      <p class="smb-callout">BLS figures are <strong>employee wages, not client prices</strong>: what web developers and designers are paid, not what a business pays for a website.</p>
      <div class="smb-table"><table><thead><tr><th scope="col">Figure</th><th scope="col">Value</th><th scope="col">Label</th><th scope="col">Ref.</th><th scope="col">Data date</th></tr></thead><tbody><tr><th scope="row" data-label="Figure">Web developers, median hourly wage</th><td data-label="Value">$44.54/hr</td><td data-label="Label"><span class="smb-tag">Official (government)</span></td><td data-label="Ref."><a href="#ref-1">[1]</a></td><td data-label="Data date">May 2025</td></tr><tr><th scope="row" data-label="Figure">Web developers, mean hourly wage</th><td data-label="Value">$47.49/hr (annual mean $98,770)</td><td data-label="Label"><span class="smb-tag">Official (government)</span></td><td data-label="Ref."><a href="#ref-1">[1]</a></td><td data-label="Data date">May 2025</td></tr><tr><th scope="row" data-label="Figure">Web and digital interface designers, median hourly wage</th><td data-label="Value">$50.00/hr</td><td data-label="Label"><span class="smb-tag">Official (government)</span></td><td data-label="Ref."><a href="#ref-1">[1]</a></td><td data-label="Data date">May 2025</td></tr><tr><th scope="row" data-label="Figure">Web and digital interface designers, mean hourly wage</th><td data-label="Value">$56.49/hr (annual mean $117,490)</td><td data-label="Label"><span class="smb-tag">Official (government)</span></td><td data-label="Ref."><a href="#ref-1">[1]</a></td><td data-label="Data date">May 2025</td></tr><tr><th scope="row" data-label="Figure">40-hour small site at the BLS median wage</th><td data-label="Value">$1,781.60 (developer); $2,000.00 (designer). Derived example, not an official figure: 40 hours is an assumption, wage cost only, no overhead, profit, or tools.</td><td data-label="Label"><span class="smb-tag">Derived example, not an official figure</span></td><td data-label="Ref."><a href="#ref-1">[1]</a></td><td data-label="Data date">Calculated Oct 31, 2026</td></tr><tr><th scope="row" data-label="Figure">Web design projects reviewed on Clutch</th><td data-label="Value">Most cost less than $10,000; US agencies charge $100 to $149/hr; average $38,105.39, monthly average $5,279.79 (large projects skew the average; no sample size given). Clutch is paid by the agencies it lists.</td><td data-label="Label"><span class="smb-tag">Independent survey</span></td><td data-label="Ref."><a href="#ref-2">[2]</a></td><td data-label="Data date">Sep 21, 2026</td></tr><tr><th scope="row" data-label="Figure">Fixed-price web development projects</th><td data-label="Value">63% of agencies quote $1,000 to $15,000; basic sites $1,000 to $3,000 for 60% of agencies; US hourly $50 to $100. Global survey of 300+ firms in 31 countries; GoodFirms is also paid by the agencies it lists.</td><td data-label="Label"><span class="smb-tag">Independent survey</span></td><td data-label="Ref."><a href="#ref-3">[3]</a></td><td data-label="Data date">Oct 14, 2026</td></tr><tr><th scope="row" data-label="Figure">Agency monthly retainers</th><td data-label="Value">$500 to $3,000 for nearly 58% of the market (retainers, not strictly maintenance). GoodFirms is paid by listed agencies.</td><td data-label="Label"><span class="smb-tag">Independent survey</span></td><td data-label="Ref."><a href="#ref-3">[3]</a></td><td data-label="Data date">Oct 14, 2026</td></tr><tr><th scope="row" data-label="Figure">Small-business website cost</th><td data-label="Value">Professional design $1,500 and up; DIY $0 to $450; hosting and apps $15 to $150/mo; maintenance $20 to $100/yr. Editorial estimate, not a survey; no method given. Forbes Advisor earns affiliate revenue.</td><td data-label="Label"><span class="smb-tag">Independent survey (editorial estimate)</span></td><td data-label="Ref."><a href="#ref-4">[4]</a></td><td data-label="Data date">Sep 17, 2026</td></tr><tr><th scope="row" data-label="Figure">Web developer freelance rate</th><td data-label="Value">$15 to $50/hr, worldwide</td><td data-label="Label"><span class="smb-tag">Vendor-published price or estimate</span></td><td data-label="Ref."><a href="#ref-5">[5]</a></td><td data-label="Data date">Undated</td></tr><tr><th scope="row" data-label="Figure">AI developer freelance rate</th><td data-label="Value">$30 to $150/hr, worldwide</td><td data-label="Label"><span class="smb-tag">Vendor-published price or estimate</span></td><td data-label="Ref."><a href="#ref-6">[6]</a></td><td data-label="Data date">Undated</td></tr><tr><th scope="row" data-label="Figure">Custom AI/automation project cost for small businesses</th><td data-label="Value">Not available: no government or independent national average exists</td><td data-label="Label"><span class="smb-tag">None</span></td><td data-label="Ref.">None</td><td data-label="Data date">n/a</td></tr></tbody></table></div>
    </details>
    <details class="smb-details">
      <summary>Competitor prices <span class="smb-tag">Vendor-published price or estimate</span></summary>
      <div class="smb-table"><table><thead><tr><th scope="col">Provider</th><th scope="col">Service</th><th scope="col">Published price</th><th scope="col">Date</th><th scope="col">Source</th></tr></thead><tbody><tr><th scope="row" data-label="Provider">Bravoya (agency)</th><td data-label="Service">Starter 5-page site + hosting/maintenance</td><td data-label="Published price">$500 one-time, then $99/mo</td><td data-label="Date">No date on page</td><td data-label="Source"><a href="https://bravoya.com/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Bravoya</th><td data-label="Service">Growth / Pro tiers</td><td data-label="Published price">$800 + $149/mo; $1,200 + $249/mo</td><td data-label="Date">No date on page</td><td data-label="Source"><a href="https://bravoya.com/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Agency Crate</th><td data-label="Service">Starter build (up to 5 pages)</td><td data-label="Published price">Starting at $2,495</td><td data-label="Date">Oct 7, 2026</td><td data-label="Source"><a href="https://agencycrate.com/resources/small-business-website-cost/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Agency Crate</th><td data-label="Service">Professional build (up to 12 pages)</td><td data-label="Published price">Starting at $4,495</td><td data-label="Date">Oct 7, 2026</td><td data-label="Source"><a href="https://agencycrate.com/resources/small-business-website-cost/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Agency Crate</th><td data-label="Service">Care plan (incl. hosting)</td><td data-label="Published price">Starting at $225/mo; hosting only from $85/mo</td><td data-label="Date">Oct 7, 2026</td><td data-label="Source"><a href="https://agencycrate.com/resources/small-business-website-cost/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Agency Crate</th><td data-label="Service">Managed site + AI chat/voice assistant + CRM</td><td data-label="Published price">Starting at $499/mo plus $1,500 setup</td><td data-label="Date">Oct 7, 2026</td><td data-label="Source"><a href="https://agencycrate.com/resources/small-business-website-cost/" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Teqri</th><td data-label="Service">Managed site plans</td><td data-label="Published price">$25 / $50 / $129 per month, no setup fee</td><td data-label="Date">Aug 25, 2026</td><td data-label="Source"><a href="https://teqri.com/smb" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Theo</th><td data-label="Service">Website packages</td><td data-label="Published price">$29.99 / $69.99 / $129.99 per month</td><td data-label="Date">Oct 15, 2026</td><td data-label="Source"><a href="https://theo.site/website-design-packages" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Portland AI Works</th><td data-label="Service">AI automation build sprint (one system)</td><td data-label="Published price">$5,000 to $15,000; AI Opportunity Map $2,500; ops $1,500 to $2,500/mo</td><td data-label="Date">Sep 30, 2026</td><td data-label="Source"><a href="https://portlandaiworks.com/what-ai-costs" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">QuantAIze</th><td data-label="Service">Simple custom automation</td><td data-label="Published price">About $5,000 to $15,000; support $2,000 to $8,000/mo</td><td data-label="Date">Sep 14, 2026</td><td data-label="Source"><a href="https://quantaize.ai/guides/what-does-a-custom-ai-project-cost" rel="noopener nofollow" target="_blank">Link</a></td></tr><tr><th scope="row" data-label="Provider">Upwork (marketplace)</th><td data-label="Service">Web 