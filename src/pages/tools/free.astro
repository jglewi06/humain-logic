---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import tools from '../../data/tools.json';
import categories from '../../data/categories.json';
import { SITE } from '../../lib/site';
import { FREE_TOOLS } from '../../lib/seo-pages';
const groups = categories.map(c => ({ ...c, list: FREE_TOOLS.filter(t => t.category === c.slug) })).filter(g => g.list.length);
const ld = [
  { '@type': 'ItemList', name: 'Free AI tools', numberOfItems: FREE_TOOLS.length, itemListElement: FREE_TOOLS.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tools/${t.slug}`, name: t.name })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` }, { '@type': 'ListItem', position: 3, name: 'Free AI tools', item: `${SITE.url}/tools/free` }] },
];
---
<Base title="Free AI tools: the best ones, sorted by task" description={`The best free AI tools in plain English: ${FREE_TOOLS.length} of the ${tools.length} tools we list have a free plan. Compare what each does, paid upgrade prices and privacy notes.`} jsonld={ld}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/tools">Tools</a> › Free AI tools</p>
  <span class="eyebrow">Free plans</span><h1>Free AI tools: the best ones by task</h1>
  <p class="lede">{FREE_TOOLS.length} of the {tools.length} tools in our directory have a free plan. Free plans usually have limits, so check each tool's pricing notes before you rely on it. New to AI? Start with our <a href="/guides/what-is-ai">beginner's guide</a>.</p>
</div></section>
<div class="container">
  <nav aria-label="Groups" style="margin-top:var(--space-6)"><div class="cat-grid">{groups.map(g => <a class="cat" href={`#${g.slug}`}>{g.label} <span>{g.list.length}</span></a>)}</div></nav>
  {groups.map(g => (
    <section class="dir-section" id={g.slug} aria-labelledby={`${g.slug}-h`}>
      <h2 id={`${g.slug}-h`}>Free AI tools: {g.label.toLowerCase()} <a href={`/tools/category/${g.slug}`} style="font:500 var(--fs-small) var(--font-body);margin-left:var(--space-2)">All {g.label} tools →</a></h2>
      <div class="grid-3">{g.list.map(t => <ToolCard tool={t} />)}</div>
    </section>))}
  <p class="note">We’re independent. No company pays to be listed. “Free plan” means the tool's official pricing page offers a no-cost tier; limits vary.</p>
</div>
</Base>
