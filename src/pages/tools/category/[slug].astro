---
import Base from '../../../layouts/Base.astro';
import ToolCard from '../../../components/ToolCard.astro';
import tools from '../../../data/tools.json';
import categories from '../../../data/categories.json';
import { SITE } from '../../../lib/site';
export function getStaticPaths() { return categories.map(c => ({ params: { slug: c.slug }, props: { cat: c } })); }
const { cat } = Astro.props;
const list = tools.filter(t => t.category === cat.slug);
// Most common per-tool disclaimer in the group (from research tool-details); each tool page shows its own.
const dc = list.filter(t => t.disclaimer).reduce((m, t) => m.set(t.disclaimer, (m.get(t.disclaimer) ?? 0) + 1), new Map());
const disclaimer = [...dc].sort((a, b) => b[1] - a[1])[0]?.[0];
const url = `${SITE.url}/tools/category/${cat.slug}`;
const ld = [
  { '@type': 'ItemList', name: `${cat.label}: AI tools`, url, numberOfItems: list.length, itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tools/${t.slug}`, name: t.name })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` }, { '@type': 'ListItem', position: 3, name: cat.label, item: url }] },
];
---
<Base title={`Best AI tools: ${cat.label.toLowerCase()}`} description={`The best AI tools for ${cat.label.toLowerCase()}: ${list.length} options compared in plain English, with checked prices, free plans and privacy notes so you can pick the right one.`} jsonld={ld}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/tools">Tools</a> › {cat.label}</p>
  <span class="eyebrow">Find a tool</span><h1>{cat.label}</h1>
  <p class="lede">{list.length} tool{list.length === 1 ? '' : 's'} in this group. Not sure what to pick? <a href="/search">Describe your task</a>.</p>
  {disclaimer && <div class="panel" role="note" style="margin-top:var(--space-4);border-left:4px solid var(--color-teal)"><p style="margin:0"><strong>Important:</strong> {disclaimer}</p></div>}
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div class="grid-3">{list.map(t => <ToolCard tool={t} />)}</div>
  <nav aria-label="Other groups" style="margin-top:var(--space-8)"><h2 style="font-size:var(--fs-h4);margin-bottom:var(--space-3)">Other groups</h2><div class="cat-grid">{categories.filter(c => c.slug !== cat.slug).map(c => <a class="cat" href={`/tools/category/${c.slug}`}>{c.label} <span>{c.count}</span></a>)}</div></nav>
</div>
</Base>
