---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import { toolLd } from '../../lib/ld.mjs';
import tools from '../../data/tools.json';
import tasks from '../../data/tasks.json';
import { mailto, SITE, tint, initials, priceStatus, freeText, fmtMonthDay } from '../../lib/site';
export function getStaticPaths() { return tools.map(t => ({ params: { slug: t.slug }, props: { tool: t } })); }
const { tool } = Astro.props;
const [bg, fg] = tint(tool.slug);
const p = tool.pricing; const d = tool.details;
const myTasks = tool.tasks.map(s => tasks.find(t => t.slug === s)).filter(Boolean);
const alts = tools.filter(t => t.slug !== tool.slug && t.category === tool.category).slice(0, 3);
const ld = [
  toolLd(tool),
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` }, { '@type': 'ListItem', position: 3, name: tool.category_label, item: `${SITE.url}/tools/category/${tool.category}` }, { '@type': 'ListItem', position: 4, name: tool.name, item: `${SITE.url}/tools/${tool.slug}` }] },
];
---
<Base title={`${tool.name}: what it does, price and privacy`} description={`${tool.name}: ${tool.summary}`} jsonld={ld}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/tools">Tools</a> › <a href={`/tools/category/${tool.category}`}>{tool.category_label}</a> › {tool.name}</p>
  <div class="tool-head">
    <div style="display:flex;gap:var(--space-4);align-items:center">
      <div class="tile" style={`background:${bg};color:${fg}`} aria-hidden="true">{initials(tool.name)}</div>
      <div><h1 style="margin:0">{tool.name}</h1><p class="lede" style="margin-top:var(--space-2)">{tool.summary}</p></div>
    </div>
    <div><a class="btn btn-primary" href={tool.website} rel="noopener">Visit {tool.name} <svg width="16" height="16" aria-hidden="true"><use href="#i-ext"/></svg></a></div>
  </div>
  <div class="badges" style="margin-top:var(--space-4)">{tool.companion && <span class="b b-unverified">AI companion, not therapy</span>}<span class="b b-price">{tool.pricing.label}</span>{p.verified ? <span class="b b-verified">Price verified {fmtMonthDay(p.verified_on)}</span> : <span class="b b-unverified">Pricing unconfirmed</span>}{tool.affiliate && <span class="b b-affiliate">Affiliate link</span>}</div>
  {tool.disclaimer && <div class="panel tool-disclaimer" role="note" aria-label="Important" style="margin-top:var(--space-4);border-left:4px solid var(--color-teal)"><p style="margin:0"><strong>Important:</strong> {tool.disclaimer}</p></div>}
  <p class="confidence" style="margin-top:var(--space-3)"><a href={mailto(`Outdated info: ${SITE.url}/tools/${tool.slug}`, `Page: ${SITE.url}/tools/${tool.slug}\nWhat looks wrong:\nCorrect source (if you have one):\n`)}>Report outdated info</a></p>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div class="detail">
    <div class="prose" style="max-width:none">
      {d && <><h2>What it does</h2><p>{d.what_it_does}</p>
      <h2>Who it's for</h2><p>{d.who_its_for}</p>
      <div class="grid-2" style="margin:var(--space-4) 0">
        <div class="panel"><h3 style="font-size:var(--fs-h4);margin-bottom:var(--space-2)"><span aria-hidden="true">✓ </span>Good points</h3><ul style="margin:0;padding-left:20px">{d.pros.map(x => <li>{x}</li>)}</ul></div>
        <div class="panel"><h3 style="font-size:var(--fs-h4);margin-bottom:var(--space-2)"><span aria-hidden="true">! </span>Watch out for</h3><ul style="margin:0;padding-left:20px">{d.cons.map(x => <li>{x}</li>)}</ul></div>
      </div></>}
      <h2>Good for</h2>
      <div class="chips" style="justify-content:flex-start">{myTasks.map(t => <a class="chip" href={`/tasks/${t.slug}`}>{t.name}</a>)}</div>
      <h2 id="pricing">Pricing</h2>
      <div class="panel">
        <p style="margin-bottom:var(--space-2)"><strong>{freeText(p)}</strong>{p.starting_paid_price && <> · Paid plans from <strong>{p.starting_paid_price}</strong></>}</p>
        {p.summary && <p style="margin-bottom:var(--space-2)">{p.summary}</p>}
        {p.verified
          ? <p class="confidence">Last verified {fmtMonthDay(p.verified_on)} on the official pricing page. Prices can change; check before you buy.</p>
          : <p class="confidence"><strong>Pricing unconfirmed.</strong> {p.verification_note}</p>}
        {p.pricing_url && <p style="margin-top:var(--space-2)"><a href={p.pricing_url} rel="noopener">Official pricing page <svg width="14" height="14" aria-hidden="true"><use href="#i-ext"/></svg></a></p>}
      </div>
      {tool.disclaimer && <p class="confidence"><strong>Reminder:</strong> {tool.disclaimer}</p>}
      {tool.privacy?.summary && <><h2>Privacy and safety</h2><p>{tool.privacy.summary}</p></>}
      {alts.length > 0 && <><h2>Alternatives</h2><div class="grid-3">{alts.map(t => <ToolCard tool={t} />)}</div></>}
    </div>
    <aside class="panel glance" aria-labelledby="g-h">
      <h2 id="g-h" style="font-size:var(--fs-h4);margin-bottom:var(--space-3)">At a glance</h2>
      <dl>
        {tool.developer && <><dt>Made by</dt><dd>{tool.developer}</dd></>}
        <dt>Group</dt><dd><a href={`/tools/category/${tool.category}`}>{tool.category_label}</a></dd>
        <dt>Price</dt><dd>{p.label}{p.starting_paid_price ? `; paid from ${p.starting_paid_price}` : ''}</dd>
        <dt>Pricing</dt><dd>{priceStatus(p)}</dd>
        {tool.skill_level && <><dt>Skill</dt><dd>{tool.skill_level}</dd></>}
        {tool.platforms?.length > 0 && <><dt>Platforms</dt><dd>{tool.platforms.join(', ')}</dd></>}
      </dl>
      <p class="confidence" style="margin-top:var(--space-3)">Details and prices come from the tool's official pages. No company pays to be listed.</p>
    </aside>
  </div>
  <div class="sticky-cta"><a class="btn btn-primary" href={tool.website} rel="noopener">Visit {tool.name}</a></div>
</div>
</Base>
