---
import Base from '../layouts/Base.astro';
---
<Base title="Contact us">
<section class="page-head"><div class="container"><span class="eyebrow">Contact</span><h1>Contact us</h1></div></section>
<div class="container section" style="padding-top:var(--space-6)"><div class="prose">
<p>We read every message.</p>
<h2 id="report">Report a problem or outdated info</h2><p class="placeholder">Contact email/form: placeholder until Francisco sets up a mailbox for humainlogic.com.</p>
<h2 id="suggest">Suggest a tool or a job to track</h2><p class="placeholder">Suggestion form: placeholder (a free static-form option is listed in tech/plan.md).</p>
</div></div>
</Base>
