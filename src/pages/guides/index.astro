---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import meta from '../../data/guides.json';
import { SITE } from '../../lib/site';
const entries = await getCollection('guides');
const guides = meta.map(m => ({ ...m, entry: entries.find(e => e.id === m.slug) })).filter(g => g.entry);
const ld = [{ '@type': 'ItemList', name: 'HumAIn Logic guides', itemListElement: guides.map((g, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/guides/${g.slug}`, name: g.title })) }];
---
<Base title="Guides" description="Short, plain-language guides to using AI safely at home, at work and in a small business." jsonld={ld}>
<section class="page-head"><div class="container"><span class="eyebrow">Guides</span><h1>Plain-language AI guides</h1><p class="lede">Short reads you can finish with a coffee. New to AI? Start with <a href="/learn">AI, explained simply</a>.</p></div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <ol class="grid-2" style="list-style:none;padding:0;margin:0">
    {guides.map(g => (
      <li id={g.slug === 'ai-for-small-business' ? 'small-business' : undefined}><article class="news-card" style="height:100%">
        <h2><a href={`/guides/${g.slug}`}>{g.title}</a></h2>
        <p>{g.summary}</p>
        <span class="meta">{g.reading_time} · Updated <time datetime={g.updated}>{g.updated}</time></span>
      </article></li>))}
  </ol>
</div>
</Base>
