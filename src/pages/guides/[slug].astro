---
import Base from '../../layouts/Base.astro';
import GuidePhoto from '../../components/GuidePhoto.astro';
import { getCollection, render } from 'astro:content';
import meta from '../../data/guides.json';
import { SITE, fmtMonthDay } from '../../lib/site';
export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry, m: meta.find(g => g.slug === entry.id) } }));
}
const { entry, m } = Astro.props;
const { Content } = await render(entry);
const others = meta.filter(g => g.slug !== entry.id).slice(0, 3);
const updated = entry.data.updated.toISOString().slice(0, 10);
const published = entry.data.published?.toISOString().slice(0, 10);
const authorName = entry.data.author ?? 'HumAIn Logic editorial team';
const authorLd = entry.data.author && !/team|staff|editor/i.test(entry.data.author) ? { '@type': 'Person', name: entry.data.author } : { '@type': 'Organization', name: 'HumAIn Logic editorial team', url: `${SITE.url}/about`, parentOrganization: { '@id': `${SITE.url}/#org` } };
const ld = [
  { '@type': 'Article', headline: entry.data.title, description: entry.data.summary, ...(published ? { datePublished: published } : {}), dateModified: updated, author: authorLd, publisher: { '@id': `${SITE.url}/#org` }, mainEntityOfPage: `${SITE.url}/guides/${entry.id}`, ...(m?.sources ? { citation: m.sources.map(s => ({ '@type': 'CreativeWork', url: s.url, ...(s.title ? { name: s.title } : {}), ...(s.publisher ? { publisher: { '@type': 'Organization', name: s.publisher } } : {}) })) } : {}) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE.url}/guides` }, { '@type': 'ListItem', position: 3, name: entry.data.title, item: `${SITE.url}/guides/${entry.id}` }] },
];
---
<Base title={entry.data.title} description={entry.data.summary} jsonld={ld} path={`/guides/${entry.id}`}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/guides">Guides</a> › {entry.data.title}</p>
  <span class="eyebrow">Guide</span><h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <p class="confidence" style="margin-top:var(--space-3)">By {authorName} · {published && <>Published <time datetime={published}>{fmtMonthDay(published)}</time> · </>}Updated <time datetime={updated}>{fmtMonthDay(updated)}</time> · {m?.reading_time}</p>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  {entry.data.hero && <GuidePhoto base={entry.data.hero.src} alt={entry.data.hero.alt} eager />}
  <article class="prose guide"><Content /></article>
  {others.length > 0 && <section style="margin-top:var(--space-7)" aria-labelledby="more-h"><h2 id="more-h" style="font-size:var(--fs-h3);margin-bottom:var(--space-4)">More guides</h2>
    <div class="grid-3">{others.map(g => <article class="news-card"><h3><a href={`/guides/${g.slug}`}>{g.title}</a></h3><p>{g.summary}</p></article>)}</div></section>}
</div>
</Base>
<style is:global>
.guide{font-size:var(--fs-body)}
.guide h2{font-size:var(--fs-h3);margin:var(--space-6) 0 var(--space-3)}
.guide h3{font-size:var(--fs-h4);margin:var(--space-5) 0 var(--space-2)}
.guide li{margin-bottom:var(--space-2)}
.guide hr{border:0;border-top:1px solid var(--color-border);margin:var(--space-6) 0}
.guide a{overflow-wrap:anywhere}
.guide-photo{aspect-ratio:16/9;max-width:100%;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.12);margin:var(--space-5) 0 var(--space-6)}
.guide .guide-photo{margin:var(--space-5) 0}
.guide-hero{max-width:44rem;margin-top:0}
.guide blockquote{background:var(--color-sage);border-left:6px solid var(--color-teal);margin:var(--space-4) 0;padding:var(--space-3) var(--space-4);border-radius:var(--radius-md)}
</style>
