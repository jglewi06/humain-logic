---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import tasks from '../../data/tasks.json';
import tools from '../../data/tools.json';
import { SITE } from '../../lib/site';
export function getStaticPaths() { return tasks.map(t => ({ params: { slug: t.slug }, props: { task: t } })); }
const { task } = Astro.props;
const list = task.tools.map(s => tools.find(t => t.slug === s)).filter(Boolean);
const related = tasks.filter(t => t.slug !== task.slug && t.categories.some(c => task.categories.includes(c))).slice(0, 8);
const ld = [{ '@type': 'ItemList', name: `Tools for: ${task.name}`, itemListElement: list.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tools/${t.slug}`, name: t.name })) }];
---
<Base title={`AI tools to ${task.name.toLowerCase()}`} description={`AI tools that can help you ${task.name.toLowerCase()}, explained in plain English.`} jsonld={ld}>
<section class="page-head"><div class="container"><p class="crumbs"><a href="/">Home</a> › <a href="/tasks">Tasks</a> › {task.name}</p><span class="eyebrow">Task</span><h1>{task.name}</h1><p class="lede">{list.length} tool{list.length === 1 ? '' : 's'} that can help.</p></div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div class="grid-3">{list.map((t, i) => <ToolCard tool={t} best={i === 0 && list.length > 1} />)}</div>
  {related.length > 0 && <section style="margin-top:var(--space-7)"><h2 style="font-size:var(--fs-h4);margin-bottom:var(--space-3)">Related tasks</h2><div class="chips" style="justify-content:flex-start">{related.map(t => <a class="chip" href={`/tasks/${t.slug}`}>{t.name}</a>)}</div></section>}
</div>
</Base>
