---
import Base from '../../layouts/Base.astro';
import tasks from '../../data/tasks.json';
import { SITE, clip, freeText, priceStatus } from '../../lib/site';
import { VS_PAIRS, vsSlug, hasAlternatives, guideFor } from '../../lib/seo-pages';
import guides from '../../data/guides.json';
export function getStaticPaths() { return VS_PAIRS.map(([a, b]) => ({ params: { slug: vsSlug(a, b) }, props: { a, b } })); }
const { a, b } = Astro.props;
const both = [a, b];
const tName = (s: string) => tasks.find(t => t.slug === s)?.name;
const shared = a.tasks.filter(s => b.tasks.includes(s));
const others = VS_PAIRS.filter(([x, y]) => [x, y].some(t => t.slug === a.slug || t.slug === b.slug) && vsSlug(x, y) !== vsSlug(a, b));
const g = guides.find(x => x.slug === guideFor(a.category));
const t1 = `${a.name} vs ${b.name}: price, free plan, privacy`, t2 = `${a.name} vs ${b.name}: which is better?`;
const title = t1.length <= 46 ? t1 : t2.length <= 46 ? t2 : `${a.name} vs ${b.name}`;
const paid = (t: any) => t.pricing.starting_paid_price ? `paid from ${t.pricing.starting_paid_price}` : 'paid price unconfirmed';
const ld = [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` }, { '@type': 'ListItem', position: 3, name: `${a.name} vs ${b.name}`, item: `${SITE.url}/compare/${vsSlug(a, b)}` }] },
  { '@type': 'ItemList', name: `${a.name} vs ${b.name}`, itemListElement: both.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tools/${t.slug}`, name: t.name })) }];
const rows: [string, (t: any) => any][] = [
  ['What it does', t => t.summary], ['Made by', t => t.developer ?? 'Not listed'], ['Free plan', t => freeText(t.pricing).replace('Free plan: ', '')],
  ['Price', t => t.pricing.label + (t.pricing.starting_paid_price ? `; paid from ${t.pricing.starting_paid_price}` : '')], ['Pricing checked', t => priceStatus(t.pricing)],
  ['Skill level', t => t.skill_level ?? 'Not listed'], ['Platforms', t => t.platforms?.length ? t.platforms.join(', ') : 'Not listed'], ['Privacy', t => t.privacy?.summary ?? 'See the tool page'],
];
---
<Base title={title} description={clip(`${a.name} vs ${b.name} compared in plain English. ${a.name}: ${a.pricing.label.toLowerCase()}, ${paid(a)}. ${b.name}: ${b.pricing.label.toLowerCase()}, ${paid(b)}. See features, privacy and who each one suits.`)} jsonld={ld}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/tools">Tools</a> › <a href={`/tools/category/${a.category}`}>{a.category_label}</a> › {a.name} vs {b.name}</p>
  <span class="eyebrow">Compare</span><h1>{a.name} vs {b.name}</h1>
  <p class="lede">Two {a.category_label.toLowerCase()} tools side by side, using the facts on our tool pages. We don't pick a winner; the right one depends on what you need.</p>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div style="overflow-x:auto"><table class="compare-table">
    <caption class="sr-only">{a.name} compared with {b.name}</caption>
    <thead><tr><th scope="col">Feature</th>{both.map(t => <th scope="col"><a href={`/tools/${t.slug}`}>{t.name}</a></th>)}</tr></thead>
    <tbody>{rows.map(([k, f]) => <tr><th scope="row">{k}</th>{both.map(t => <td>{f(t)}</td>)}</tr>)}</tbody>
  </table></div>
  <div class="grid-2" style="margin-top:var(--space-6)">
    {both.map(t => <div class="panel">
      <h2 style="font-size:var(--fs-h4)">Who {t.name} is for</h2>
      {t.details?.who_its_for && <p>{t.details.who_its_for}</p>}
      {t.details?.pros?.length > 0 && <><h3 style="font-size:var(--fs-body)">Good points</h3><ul>{t.details.pros.map(x => <li>{x}</li>)}</ul></>}
      {t.details?.cons?.length > 0 && <><h3 style="font-size:var(--fs-body)">Watch out for</h3><ul>{t.details.cons.map(x => <li>{x}</li>)}</ul></>}
      <p><a href={`/tools/${t.slug}`}>Full {t.name} page</a>{hasAlternatives(t) && <> · <a href={`/alternatives/${t.slug}`}>{t.name} alternatives</a></>}</p>
    </div>)}
  </div>
  {shared.length > 0 && <><h2>Both can help you</h2><div class="chips" style="justify-content:flex-start">{shared.map(s => <a class="chip" href={`/tasks/${s}`}>{tName(s)}</a>)}</div></>}
  {others.length > 0 && <><h2>More comparisons</h2><div class="chips" style="justify-content:flex-start">{others.map(([x, y]) => <a class="chip" href={`/compare/${vsSlug(x, y)}`}>{x.name} vs {y.name}</a>)}</div></>}
  {g && <p style="margin-top:var(--space-6)">New to this? Read our free guide: <a href={`/guides/${g.slug}`}>{g.title}</a>.</p>}
  <p class="note">We’re independent. No company pays to be listed. Prices come from each tool's official pricing page; check before you buy.</p>
</div>
</Base>
<style>
.compare-table{width:100%;border-collapse:collapse;min-width:560px}
.compare-table th,.compare-table td{text-align:left;vertical-align:top;padding:var(--space-3);border-bottom:1px solid var(--color-line, #ddd)}
.compare-table thead th{font-size:var(--fs-h4)}
.compare-table tbody th{width:22%;font-weight:600}
</style>
