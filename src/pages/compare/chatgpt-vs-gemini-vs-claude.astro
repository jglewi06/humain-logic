---
import Base from '../../layouts/Base.astro';
import tasks from '../../data/tasks.json';
import { SITE, clip, freeText, priceStatus } from '../../lib/site';
import { THREE_WAY, vsSlug, VS_PAIRS } from '../../lib/seo-pages';
const set = THREE_WAY[0]; const all = set.tools as any[];
const tName = (s: string) => tasks.find(t => t.slug === s)?.name;
const shared = all[0].tasks.filter((s: string) => all.every(t => t.tasks.includes(s)));
const pairs = VS_PAIRS.filter(([a, b]) => set.slugs.includes(a.slug) && set.slugs.includes(b.slug));
const name = all.map(t => t.name).join(' vs ');
const url = `${SITE.url}/compare/chatgpt-vs-gemini-vs-claude`;
const rows: [string, (t: any) => any][] = [
  ['What it does', t => t.summary], ['Made by', t => t.developer ?? 'Not listed'], ['Free plan', t => freeText(t.pricing).replace('Free plan: ', '')],
  ['Price', t => t.pricing.label + (t.pricing.starting_paid_price ? `; paid from ${t.pricing.starting_paid_price}` : '')], ['Pricing checked', t => priceStatus(t.pricing)],
  ['Skill level', t => t.skill_level ?? 'Not listed'], ['Platforms', t => t.platforms?.length ? t.platforms.join(', ') : 'Not listed'], ['Privacy', t => t.privacy?.summary ?? 'See the tool page'],
];
const ld = [{ '@type': 'ItemList', name, url, itemListElement: all.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/tools/${t.slug}`, name: t.name })) },
  { '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` }, { '@type': 'ListItem', position: 2, name: 'Tools', item: `${SITE.url}/tools` }, { '@type': 'ListItem', position: 3, name, item: url }] }];
---
<Base title={`${name}: which AI is best?`} description={clip(`${name}: which AI chatbot is best for you? Compare free plans, paid prices from ${all.map(t => t.pricing.starting_paid_price?.split(' ')[0]).filter(Boolean).join(', ')}, privacy, platforms and who each suits.`)} jsonld={ld}>
<section class="page-head"><div class="container">
  <p class="crumbs"><a href="/">Home</a> › <a href="/tools">Tools</a> › {name}</p>
  <span class="eyebrow">Compare</span><h1>{name}</h1>
  <p class="lede">The three best-known AI chat assistants side by side, using the facts on our tool pages. We don't pick a winner; the right one depends on what you need.</p>
</div></section>
<div class="container section" style="padding-top:var(--space-6)">
  <div style="overflow-x:auto"><table class="compare-table">
    <caption class="sr-only">{name}</caption>
    <thead><tr><th scope="col">Feature</th>{all.map(t => <th scope="col"><a href={`/tools/${t.slug}`}>{t.name}</a></th>)}</tr></thead>
    <tbody>{rows.map(([k, f]) => <tr><th scope="row">{k}</th>{all.map(t => <td>{f(t)}</td>)}</tr>)}</tbody>
  </table></div>
  <div class="grid-3" style="margin-top:var(--space-6)">
    {all.map(t => <div class="panel">
      <h2 style="font-size:var(--fs-h4)">Who {t.name} is for</h2>
      {t.details?.who_its_for && <p>{t.details.who_its_for}</p>}
      {t.details?.pros?.length > 0 && <><h3 style="font-size:var(--fs-body)">Good points</h3><ul>{t.details.pros.map((x: string) => <li>{x}</li>)}</ul></>}
      {t.details?.cons?.length > 0 && <><h3 style="font-size:var(--fs-body)">Watch out for</h3><ul>{t.details.cons.map((x: string) => <li>{x}</li>)}</ul></>}
      <p><a href={`/tools/${t.slug}`}>Full {t.name} page</a> · <a href={`/alternatives/${t.slug}`}>{t.name} alternatives</a></p>
    </div>)}
  </div>
  {shared.length > 0 && <><h2>All three can help you</h2><div class="chips" style="justify-content:flex-start">{shared.map((s: string) => <a class="chip" href={`/tasks/${s}`}>{tName(s)}</a>)}</div></>}
  <h2>Head-to-head</h2><div class="chips" style="justify-content:flex-start">{pairs.map(([a, b]) => <a class="chip" href={`/compare/${vsSlug(a, b)}`}>{a.name} vs {b.name}</a>)}</div>
  <p style="margin-top:var(--space-6)">New to AI chat? Read our free guide: <a href="/guides/getting-started-with-ai-chat-assistants">Getting started with AI chat assistants</a>.</p>
  <p class="note">We’re independent. No company pays to be listed. Prices come from each tool's official pricing page; check before you buy.</p>
</div>
</Base>
<style>
.compare-table{width:100%;border-collapse:collapse;min-width:680px}
.compare-table th,.compare-table td{text-align:left;vertical-align:top;padding:var(--space-3);border-bottom:1px solid var(--color-line, #ddd)}
.compare-table tbody th{width:18%;font-weight:600}
</style>
